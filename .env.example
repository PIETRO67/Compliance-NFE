# Valores obrigatórios gerados por python scripts/configure_m1.py (não use valores públicos em produção).
APP_ENV=development
ENABLE_DEV_TOOLS=false
DATABASE_URL=postgresql+psycopg://compliance_app:CHANGE_ME@127.0.0.1:55432/compliance
MIGRATION_DATABASE_URL=postgresql+psycopg://compliance:CHANGE_ME@127.0.0.1:55432/compliance
APP_DB_USER=compliance_app
APP_DB_PASSWORD=CHANGE_ME
POSTGRES_USER=compliance
POSTGRES_DB=compliance
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MFA_ENCRYPTION_KEY=GENERATE_FERNET_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_HOURS=8
IDLE_MINUTES=30

# M2: apenas Sandbox. Configure localmente; não use chaves de produção.
PAYMENT_PROVIDER=disabled
ASAAS_MODE=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_HTTP_USER_AGENT=IAComplianceNFSe-M2/0.2
ENABLE_BILLING_SANDBOX=false
ENABLE_BILLING_PRODUCTION=false
